{% if instagramUrl %}
{% set cleanInstagramUrl = instagramUrl | trim %}
<div class="instagram-embed" data-instagram-url="{{ cleanInstagramUrl }}" aria-label="Instagram post">
  <blockquote class="instagram-media" data-instgrm-permalink="{{ cleanInstagramUrl }}" data-instgrm-version="14">
    <a href="{{ cleanInstagramUrl }}" target="_blank" rel="noopener noreferrer">View this post on Instagram</a>
  </blockquote>
  <noscript><p><a href="{{ cleanInstagramUrl }}" target="_blank" rel="noopener noreferrer">View the original Instagram post ↗</a></p></noscript>
</div>
{% endif %}
