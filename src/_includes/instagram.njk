{#- Usage: {% set instagramUrl = ... %}{% set igImage = optional uploaded photo %}{% include "instagram.njk" %}
    Renders a lightweight placeholder; /_js/instagram.js swaps in the real embed when it scrolls into view. -#}
{% if instagramUrl %}
{% set ig = instagramUrl | trim | igParse %}
{% if ig %}
<div class="ig-embed" data-ig-kind="{{ ig.kind }}" data-ig-code="{{ ig.code }}">
  <div class="ig-stage">
    {% if igImage %}<img class="ig-poster" src="{{ igImage }}" alt="{{ igAlt or 'Fashion look from Instagram' }}" loading="lazy" decoding="async">{% endif %}
  </div>
  <a class="ig-open" href="{{ ig.url }}" target="_blank" rel="noopener noreferrer">View on Instagram ↗</a>
</div>
{% else %}
<p class="ig-open"><a href="{{ instagramUrl | trim }}" target="_blank" rel="noopener noreferrer">View on Instagram ↗</a></p>
{% endif %}
{% endif %}
