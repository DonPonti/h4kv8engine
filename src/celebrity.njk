---
pagination:
  data: hfk.celebrities
  size: 1
  alias: celebrity
permalink: "/celebrities/{{ celebrity.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ celebrity.name }} Shoes & Fashion"
  description: "{{ celebrity.name }} latest sneaker and fashion sightings on Hunting For Kicks."
---
{% set updates = hfk.updates | where("celebritySlug", celebrity.slug) | sort(attribute="date", reverse=true) %}
{% set trackedShoes = updates | where("shoeSlug", "") %}
<section class="hfk-profile">
  <p class="eyebrow">{{ celebrity.category or "Celebrity Style" }}</p>
  <h1>{{ celebrity.name }} Shoes & Fashion</h1>
  {% if celebrity.bio %}<p class="profile-bio">{{ celebrity.bio }}</p>{% endif %}
  {% if celebrity.instagram %}<a href="https://www.instagram.com/{{ celebrity.instagram | replace("@","") }}/" target="_blank" rel="noopener noreferrer">@{{ celebrity.instagram | replace("@","") }}</a>{% endif %}
  <div class="profile-stats">
    <span><strong>{{ updates.length }}</strong> tracked looks</span>
    <span><strong>{{ updates | uniqueBy("shoeSlug") | length }}</strong> shoe references</span>
  </div>
</section>

<section class="related-block">
  <div class="section-heading"><h2>Latest Looks</h2><span>{{ updates.length }} tracked</span></div>
  {% if updates.length %}
  <div class="look-feed">
  {% for update in updates %}
  <article class="look-card">
    <div class="look-meta"><time datetime="{{ update.date }}">{{ update.date }}</time>{% if update.occasion %} · {{ update.occasion }}{% endif %}</div>
    <h3>{% if update.shoeSlug %}<a href="/shoes/{{ update.shoeSlug }}/">{{ update.shoeName }}</a>{% else %}Shoe not identified{% endif %}</h3>
    {% if update.description %}<p>{{ update.description }}</p>{% endif %}
    {% set lookShoe = hfk.shoes | where("slug", update.shoeSlug) | first %}
    {% if lookShoe %}{% include "shop-links.njk" %}{% endif %}
    {% if update.instagramUrl %}{% set instagramUrl = update.instagramUrl %}{% include "instagram.njk" %}{% endif %}
  </article>
  {% endfor %}
  </div>
  {% else %}
  <div class="panel"><p>No fashion updates have been catalogued yet.</p></div>
  {% endif %}
</section>

{% set shoeRefs = updates | uniqueBy("shoeSlug") %}
<section class="related-block">
  <div class="section-heading"><h2>Shoes Worn by {{ celebrity.name }}</h2><span>{{ shoeRefs.length }}</span></div>
  <div class="hfk-grid">
  {% for ref in shoeRefs %}
    {% if ref.shoeSlug %}{% set shoe = hfk.shoes | where("slug", ref.shoeSlug) | first %}{% if shoe %}
    <a class="hfk-card" href="/shoes/{{ shoe.slug }}/"><span class="eyebrow">{{ shoe.brand }}</span><h3>{{ shoe.name }}</h3><p>{{ hfk.updates | where("shoeSlug", shoe.slug) | length }} celebrity sightings</p></a>
    {% endif %}{% endif %}
  {% else %}<p>No shoes identified yet.</p>{% endfor %}
  </div>
</section>

<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"ProfilePage",
  "name":"{{ celebrity.name }} Shoes & Fashion",
  "url":"{{ page.url | url | absoluteUrl(site.url) }}",
  "mainEntity":{"@type":"Person","name":"{{ celebrity.name }}"{% if celebrity.instagram %},"sameAs":["https://www.instagram.com/{{ celebrity.instagram | replace("@","") }}/"]{% endif %}}
}
</script>