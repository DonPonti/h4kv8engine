---
pagination:
  data: hfk.celebrities
  size: 1
  alias: celebrity
permalink: "/celebrities/{{ celebrity.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ celebrity.name }} Shoes & Fashion"
  description: "{{ celebrity.name }} latest sneaker and fashion sightings on Hunting For Kicks."
---
<section class="hfk-profile">
  <p class="eyebrow">Celebrity Style</p>
  <h1>{{ celebrity.name }}</h1>
  {% if celebrity.bio %}<p class="profile-bio">{{ celebrity.bio }}</p>{% endif %}
  {% if celebrity.instagram %}<a href="https://www.instagram.com/{{ celebrity.instagram | replace("@","") }}/" target="_blank" rel="noopener noreferrer">@{{ celebrity.instagram | replace("@","") }}</a>{% endif %}
</section>

{% if updates.length %}
<section class="related-block">
<h2>Related Celebrity Style</h2>
<div class="hfk-grid">
{% set seenShoes = [] %}
{% for update in updates %}
{% if update.shoeSlug and not (update.shoeSlug in seenShoes) %}
{% set seenShoes = seenShoes.concat(update.shoeSlug) %}
{% set shoe = hfk.shoes | where("slug", update.shoeSlug) | first %}
{% if shoe %}<a class="hfk-card" href="/shoes/{{ shoe.slug }}/"><span class="eyebrow">{{ shoe.brand }}</span><h3>{{ shoe.name }}</h3><p>View celebrity sightings →</p></a>{% endif %}
{% endif %}
{% endfor %}
</div>
</section>
{% endif %}

<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"ProfilePage",
  "name":"{{ celebrity.name }} Shoes & Fashion",
  "url":"{{ page.url | url | absoluteUrl(site.url) }}",
  "mainEntity":{"@type":"Person","name":"{{ celebrity.name }}"{% if celebrity.instagram %},"sameAs":["https://www.instagram.com/{{ celebrity.instagram | replace("@","") }}/"]{% endif %}}
}
</script>

<h2>Latest Looks</h2>
{% set related = hfk.celebrities | rejectattr("slug", "equalto", celebrity.slug) | selectattr("category", "equalto", celebrity.category) | list | slice(0,6) %}
{% set updates = hfk.updates | where("celebritySlug", celebrity.slug) | sort(attribute="date", reverse=true) %}
{% for update in updates %}
<article class="look-card">
  <div class="look-meta"><time datetime="{{ update.date }}">{{ update.date }}</time>{% if update.occasion %} · {{ update.occasion }}{% endif %}</div>
  <h3>{% if update.shoeSlug %}<a href="/shoes/{{ update.shoeSlug }}/">{{ update.shoeName }}</a>{% else %}Latest fashion look{% endif %}</h3>
  {% if update.description %}<p>{{ update.description }}</p>{% endif %}
    {% if update.shoeSlug %}
      {% set lookShoe = hfk.shoes | where("slug", update.shoeSlug) | first %}
      {% if lookShoe and lookShoe.affiliates and lookShoe.affiliates.length %}
      <div class="shop-box">
        <h4>Shop this look</h4>
        <div class="shop-links">
        {% for offer in lookShoe.affiliates %}
          {% if offer.url %}<a class="shop-link" href="{{ offer.url }}" target="_blank" rel="sponsored nofollow noopener"><span>{{ offer.retailer }}</span><strong>{% if offer.label %}{{ offer.label }}{% else %}Check price{% endif %} →</strong></a>{% endif %}
        {% endfor %}
        </div>
      </div>
      {% endif %}
    {% endif %}
  {% set instagramUrl = update.instagramUrl %}
  {% include "instagram.njk" %}
</article>
{% else %}
<p>No fashion updates yet. Check back soon.</p>
{% endfor %}
